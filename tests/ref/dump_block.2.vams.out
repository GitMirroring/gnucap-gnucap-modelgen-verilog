, ms// [] *
;
    real G_s// [V(p)] *
;
    begin : A
      if ((abs(xgt) <= ms)) begin
      end
      else begin
        if ((xgt > ms)) begin
        end
        else begin
          begin : B
            real N// [V(p)] *
;
